`timescale 1ns / 1ps

module instruction_decode (
    input  wire [31:0] instr,      // The 32-bit instruction fetched from memory
    
    // Extracted Instruction Fields
    output wire [6:0]  opcode,
    output wire [4:0]  rd,
    output wire [2:0]  funct3,
    output wire [4:0]  rs1,
    output wire [4:0]  rs2,
    output wire [6:0]  funct7,
    
    // Sign-Extended Immediate Value
    output reg  [31:0] imm_ext
);

    // 1. INSTRUCTION SLICING (R-Type format covers most standard field locations)
    assign opcode = instr[6:0];
    assign rd     = instr[11:7];
    assign funct3 = instr[14:12];
    assign rs1    = instr[19:15];
    assign rs2    = instr[24:20];
    assign funct7 = instr[31:25];

    // 2. IMMEDIATE GENERATION & SIGN EXTENSION
    // RISC-V jumbles the immediate bits in the instruction to keep hardware simple,
    // so we must piece them back together and sign-extend them to 32 bits.
    always @(*) begin
        case (opcode)
            // I-Type (e.g., ADDI, LW, JALR)
            7'b0000011, // Loads
            7'b0010011, // ALU I-Type
            7'b1100111: // JALR
                imm_ext = {{20{instr[31]}}, instr[31:20]};
            
            // S-Type (e.g., SW)
            7'b0100011: // Stores
                imm_ext = {{20{instr[31]}}, instr[31:25], instr[11:7]};
            
            // B-Type (e.g., BEQ, BNE)
            // Note: The LSB is an implicit 0, so we shift everything left by 1
            7'b1100011: // Branches
                imm_ext = {{20{instr[31]}}, instr[7], instr[30:25], instr[11:8], 1'b0};
            
            // U-Type (e.g., LUI, AUIPC)
            // Immediates are placed in the upper 20 bits
            7'b0110111, // LUI
            7'b0010111: // AUIPC
                imm_ext = {instr[31:12], 12'b0};
            
            // J-Type (e.g., JAL)
            // Note: The LSB is an implicit 0
            7'b1101111: // JAL
                imm_ext = {{12{instr[31]}}, instr[19:12], instr[20], instr[30:21], 1'b0};
            
            // Default fallback (R-Type instructions do not use immediates)
            default: 
                imm_ext = 32'b0;
        endcase
    end

endmodule
